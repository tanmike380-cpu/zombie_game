# Unity serializes empty YAML values with a trailing space.
*.asset whitespace=-blank-at-eol
*.meta whitespace=-blank-at-eol
*.unity whitespace=-blank-at-eol
*.mat whitespace=-blank-at-eol
*.prefab whitespace=-blank-at-eol
# Formal source masters and portable runtime snapshots use LFS from this commit.
# Existing frozen tags/history are not rewritten; working asset bytes stay intact.
"art/Blender主文件/*.blend" filter=lfs diff=lfs merge=lfs -text
Assets/_Game/Resources/CoastalUnits/*.asset filter=lfs diff=lfs merge=lfs -text
Assets/_Game/Resources/CharacterGenerated/*.asset filter=lfs diff=lfs merge=lfs -text
Assets/_Game/Resources/CharacterGenerated/**/*.asset filter=lfs diff=lfs merge=lfs -text
Assets/_Game/Resources/TripoCrossbow/Frames.asset filter=lfs diff=lfs merge=lfs -text
