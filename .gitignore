# Local art-tool caches and Blender autosave backups (keep authored .blend masters).
__pycache__/
*.pyc
*.blend1
*.blend2

# Crash reports
sysinfo.txt

# Unity package / build artifacts
*.apk
*.aab
*.unitypackage

# Keep Unity .meta files. Do NOT add *.meta here.
# Generated build copy; edit only balance/unit_balance.json.
/Assets/_Game/Resources/BalanceGenerated/
/Assets/_Game/Resources/BalanceGenerated.meta
/Assets/_Game/Resources/CharacterGenerated/
/Assets/_Game/Resources/CharacterGenerated.meta
# Rebuilt from authored Tripo FBX sources by the review build commands.
/Assets/_Game/Resources/TripoArcher/
/Assets/_Game/Resources/TripoArcher.meta
/Assets/_Game/Resources/TripoCrossbow/
/Assets/_Game/Resources/TripoCrossbow.meta
/Assets/_Game/Resources/TripoExploder/
/Assets/_Game/Resources/TripoExploder.meta
/Assets/_Game/Resources/CoastalBuildings/
/Assets/_Game/Resources/CoastalBuildings.meta
/Assets/_Game/Resources/CoastalUnits/
/Assets/_Game/Resources/CoastalUnits.meta
# Exporter-generated duplicate texture copies; authored PNGs and the manifest sit beside each FBX.
/Assets/_Game/Art/CoastalImports/**/*.fbm/
/Assets/_Game/Art/CoastalImports/**/*.fbm.meta
/Assets/_Game/Art/TripoCrossbow/UnityMetallicSmoothness.png
/Assets/_Game/Art/TripoCrossbow/UnityMetallicSmoothness.png.meta
/Assets/_Game/ArtGenerated/
/Assets/_Game/ArtGenerated.meta
# Reproducible CC0 download cache; sources and checksums live in art/free_environment_manifest.json.
/Assets/_Game/Resources/FreeEnvironment/
/Assets/_Game/Resources/FreeEnvironment.meta
